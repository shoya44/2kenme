{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsugidoko",
  "main": "worker/index.ts",
  // @cloudflare/vitest-pool-workers が同梱する workerd が対応する最新日付に合わせる。
  // これより新しい日付にすると worker のテストが起動しない。
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // 静的アセットは通常Workerを経由させず、/api/* だけWorkerを先に通す
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // HOTPEPPER_API_KEY は Secret。デプロイ時に登録する。
  //
  // ALLOWED_ORIGIN は設定しない。未設定なら Worker 自身のオリジンを許可する（BE-001 §5）。
  // 静的アセットとAPIは同じWorkerが配信するため、本番では設定不要。
  // F/Eを別ポートで動かす開発時だけ .dev.vars で指定する
}
